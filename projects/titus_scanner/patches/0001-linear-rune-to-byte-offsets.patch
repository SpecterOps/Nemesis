-	start, end := runeSpanToByteSpan(content, runeStart, runeLength)
+	start, end := ri.span(runeStart, runeLength)
 
 	var before, after []byte
 	if contextLines > 0 {
@@ -115,3 +116,70 @@ func buildMatchResult(
 
 	return result
 }
+
+// runeIndexStride is how many runes apart runeIndex keeps a byte-offset checkpoint.
+const runeIndexStride = 1024
+
+// runeIndex converts regexp2's rune offsets to byte offsets for one content buffer.
+//
+// runeSpanToByteSpan walks the content from the start on every call, which makes scanning a
+// buffer with many matches quadratic. runeIndex is built once per buffer in O(n): pure-ASCII
+// content (the common case) maps rune offsets to byte offsets directly, and other content keeps
+// a checkpoint every runeIndexStride runes, so each lookup decodes at most runeIndexStride runes.
+// It is read-only after construction and safe to share between goroutines.
+type runeIndex struct {
+	content     []byte
+	ascii       bool
+	checkpoints []int // byte offset of rune k*runeIndexStride
+}
+
+func newRuneIndex(content []byte) *runeIndex {
+	ri := &runeIndex{content: content, ascii: true}
+	for _, b := range content {
+		if b >= utf8.RuneSelf {
+			ri.ascii = false
+			break
+		}
+	}
+	if ri.ascii {
+		return ri
+	}
+	runeIdx := 0
+	for byteIdx := 0; byteIdx < len(content); runeIdx++ {
+		if runeIdx%runeIndexStride == 0 {
+			ri.checkpoints = append(ri.checkpoints, byteIdx)
+		}
+		_, size := utf8.DecodeRune(content[byteIdx:])
+		byteIdx += size
+	}
+	if runeIdx%runeIndexStride == 0 {
+		ri.checkpoints = append(ri.checkpoints, len(content))
+	}
+	return ri
+}
+
+// byteOffset returns the byte offset of the rune at runeIdx, or len(content) past the end.
+func (ri *runeIndex) byteOffset(runeIdx int) int {
+	if runeIdx < 0 {
+		return len(ri.content)
+	}
+	if ri.ascii {
+		return min(runeIdx, len(ri.content))
+	}
+	k := runeIdx / runeIndexStride
+	if k >= len(ri.checkpoints) {
+		return len(ri.content)
+	}
+	byteIdx := ri.checkpoints[k]
+	for i := k * runeIndexStride; i < runeIdx && byteIdx < len(ri.content); i++ {
+		_, size := utf8.DecodeRune(ri.content[byteIdx:])
+		byteIdx += size
+	}
+	return byteIdx
+}
+
+// span converts a rune-based span (regexp2 Match.Index/Length) to a byte-based span,
+// with the same results as runeSpanToByteSpan.
+func (ri *runeIndex) span(runeStart, runeLength int) (byteStart, byteEnd int) {
+	return ri.byteOffset(runeStart), ri.byteOffset(runeStart + runeLength)
+}
