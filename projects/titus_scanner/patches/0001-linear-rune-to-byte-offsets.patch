diff --git a/pkg/matcher/rune_index_test.go b/pkg/matcher/rune_index_test.go
new file mode 100644
index 0000000..980d96b
--- /dev/null
+++ b/pkg/matcher/rune_index_test.go
@@ -0,0 +1,31 @@
+package matcher
+
+import (
+	"strings"
+	"testing"
+	"unicode/utf8"
+)
+
+// runeIndex must agree with the reference runeSpanToByteSpan on every span.
+func TestRuneIndexMatchesReference(t *testing.T) {
+	inputs := map[string][]byte{
+		"empty":   {},
+		"ascii":   []byte(strings.Repeat("abc def\n", 700)),
+		"utf8":    []byte(strings.Repeat("héllo wörld ✓ 日本語 🔑 ", 300)),
+		"invalid": append([]byte(strings.Repeat("x\xff\xfe€", 600)), 0xe2, 0x82), // invalid and truncated sequences
+		"stride":  []byte(strings.Repeat("é", runeIndexStride*3)),               // checkpoints land exactly at the end
+	}
+	for name, content := range inputs {
+		ri := newRuneIndex(content)
+		runes := utf8.RuneCount(content) + 2 // include spans past the end
+		for start := -1; start <= runes; start += 7 {
+			for _, length := range []int{0, 1, 5, 1500} {
+				ws, we := runeSpanToByteSpan(content, start, length)
+				gs, ge := ri.span(start, length)
+				if start >= 0 && (ws != gs || we != ge) {
+					t.Fatalf("%s: span(%d,%d) = (%d,%d), want (%d,%d)", name, start, length, gs, ge, ws, we)
+				}
+			}
+		}
+	}
+}
